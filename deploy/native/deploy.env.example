# Fixed desired-version manifest published after the Workers API is promoted.
ROOM_MANAGER_MANIFEST_URL=https://github.com/tuatmcc/room-manager/releases/download/production/production-manifest.json

# Seconds allowed for room-manager.service to reach Type=notify readiness.
ROOM_MANAGER_CUTOVER_TIMEOUT=120

# Keep the current, previous, failed, and newest releases. Increase only when
# additional local rollback history is required.
ROOM_MANAGER_RELEASE_KEEP=5
