[Unit]
Description=room-manager green slot
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/room-manager:green
Pull=never
ContainerName=room-manager-green
AutoUpdate=local
Label=io.room-manager.slot=green
Environment=DEPLOY_COLOR=green
Environment=TZ=Asia/Tokyo
EnvironmentFile=/etc/room-manager/app.env
Volume=/var/lib/room-manager-deploy:/var/lib/room-manager-deploy:rw
Volume=/dev/bus/usb:/dev/bus/usb:rw
Volume=/dev/snd:/dev/snd:rw
AddDevice=-/dev/gpiomem
AddDevice=-/dev/gpiomem0
AddDevice=-/dev/gpiochip0
AddDevice=-/dev/gpiochip1
AddDevice=-/dev/gpiochip2
AddDevice=-/dev/gpiochip3
AddDevice=-/dev/gpiochip4
PodmanArgs=--device-cgroup-rule="c 189:* rwm"
PodmanArgs=--device-cgroup-rule="c 116:* rwm"
HealthCmd=/usr/local/bin/container-healthcheck
HealthInterval=10s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=30s
ReadOnly=true

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=900
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
