[Unit]
Description=Blue/Green deployment for room-manager
After=network-online.target room-manager-blue.service room-manager-green.service
Wants=network-online.target room-manager-blue.service room-manager-green.service
ConditionPathExists=/etc/room-manager/deploy.env

[Service]
Type=oneshot
EnvironmentFile=/etc/room-manager/deploy.env
ExecStart=/usr/local/libexec/room-manager-blue-green
TimeoutStartSec=15min

