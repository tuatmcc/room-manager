# Image published by .github/workflows/cd.yml.
ROOM_MANAGER_SOURCE_IMAGE=ghcr.io/tuatmcc/room-manager:main

# Persistent root-owned credentials for private GHCR packages. Leave this
# commented for a public package.
# REGISTRY_AUTH_FILE=/etc/room-manager/registry-auth.json

# Seconds allowed for the newly active slot to acquire the hardware lock and
# keep the application process alive.
ROOM_MANAGER_CUTOVER_TIMEOUT=60
